#%%&&%%''''&&%%""""!!!!""&&!!$$**))&&######$$''((''(((())((((''$$&&''%%%%&&&&%%%%%%$$$$$$%%%%&&%%$$$$%%%%%%####%%%%%%##""!!$$$$    ##%%&&''%%##&&**((''''**,,--++((&&''''''''''((''%%((((&&%%%%%%&&&&%%&&##""##))))%%##((&&$$''&&%%%%""$$##!!##**((''""##"""%""%%""%%%%%%%%%%&&''((''""##$$&&))&&$$$$&&''%%&&''((''((((&&""%%&&$$%%%%%%%%%%$$$$$$$$%%%%%%%%%%$$####%%##''''######""%%**''((''((((&&&&))****''))**++,,**''&&''''''''((((''((&&&&%%''&&&&&&''&&&&(($$  $$''!!$$)),,%%''**%%""  ""##!!  !!!!!!""""''%%"%""%%""%%%%%%%%%%&&''((''""##$$&&))&&$$$$&&''%%&&''((''((((&&""%%&&$$%%%%%%%%%%$$$$$$$$%%%%%%%%%%$$####%%##''''######""%%**''((''((((&&&&))****''))**++,,**''&&''''''''((((''((&&&&%%''&&&&&&''&&&&(($$  $$''!!$$)),,%%''**%%""  ""##!!  !!!!!!""""''%%"'""##""""!!##!!##''''$$""""##&&""    !!$$%%&&''))))****))''%%&&%%%%%%$$&&&&%%%%$$%%%%$$$$%%%%$$%%%%$$%%%%$$%%&&""$$,,++**++--''$$))''((''''''&&)),,**))**,,,,**,,))''))))))((((((''%%$$%%''''%%%%&&%%$$%%%%))&&((''  ##))))((''$$######((''!!!!##!!!'""##""""!!##!!##''''$$""""##&&""    !!$$%%&&''))))****))''%%&&%%%%%%$$&&&&%%%%$